# Copy this file to .env and paste your real token. Never commit .env.
GITHUB_TOKEN=
OPENAI_API_KEY=
# Qdrant vector store (Qdrant Cloud). Leave QDRANT_URL empty to use a local store in .qdrant/ instead.
QDRANT_URL=
QDRANT_API_KEY=
# Enables POST/DELETE /api/documents on the web service (adding content). Use a long random string.
LIBRARIAN_ADMIN_TOKEN=
# Deployment only (optional): a Hugging Face *write* token + HF_LOGS_REPO to keep logs on a host with a wiped disk
HF_TOKEN=
HF_LOGS_REPO=
